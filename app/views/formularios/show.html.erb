<% content_for :navbar_title do %>
  Avaliações | <%= @form.turma.disciplina[:nome] %> | <%= @form.turma[:periodo] %>
<% end %>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Forms</title>
  <%= javascript_include_tag 'forms' %> <!-- Importa o JS específico -->
</head>

<body>
  <%= render 'shared/navbar' %> <!-- Inclui a Navbar nesta página -->
  <div class="bg">
    <div class="containertwo">
      <h1 class="title title-second"><%= @form.turma.disciplina[:nome] %></h1>
      <p class="description description-second"><%= @form[:descricao] %></p>

      <%= form_with url: "#", method: :post do |form| %>
        <% @form.perguntas.each do |pergunta, index| %>
            <div class="pergunta">
            <p class="label"><strong><%= pergunta.texto %></strong></p>

            <% if pergunta.tipo_resposta == "Múltipla resposta" %>
                <% pergunta.respostas.each do |resposta| %>
                <div>
                    <%= form.radio_button "resposta_#{pergunta.id}", resposta %>
                    <%= form.label "resposta_#{resposta.pergunta_id}", resposta %>
                </div>
                <% end %>
            <% else %>
                <% pergunta.respostas.each do |resposta| %>
                  <%= form.text_area "resposta_#{resposta.pergunta_id}", placeholder: resposta.conteudo %>
                <% end %>
            <% end %>
            </div>
        <% end %>

        <div class="btn-container">
          <%= form.submit "Enviar Respostas", class: "btn btn-second" %>
        </div>
      <% end %>
    </div>
  </div>
</body>
</html>

<% content_for :navbar_title do %>
  Avaliações | <%= @form.turma.disciplina.nome %> | <%= @form.turma.periodo %>
<% end %>

