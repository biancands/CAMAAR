<div>
    <div class="container">

        <div class="content first-content">

            <div class="first-column">

                <h2 class="title">Bem vindo ao Camaar</h2>
                <p class="description">Por favor realize o login com suas informações pessoais</p>
                <button class="btn">Login</button>

            <div/>

            <div class="second-column">

                <h2 class="title">Criar conta</h2>
                <p class="description">Por favor preencha os campos abaixo</p>

                <form class="form">

                    <div class="input">
                        <label>Nome:</label>
                        <input type="text" placeholder="Insira o seu nome completo"></input>
                    </div>

                    <div class="input">
                        <label>Email:</label>
                        <input type="email" placeholder="Informe seu e-mail"></input>
                    </div>

                    <div class="input"> 
                        <label>Tipo de usuário:</label>
                        <select>
                            <option value="0">Selecione</option>
                            <option value="1">Docente</option>
                            <option value="2">Discente</option>
                        </select>
                    </div>

                    <div class="input"> 
                        <label>Matricula:</label>
                        <input type="text" placeholder="Informe sua matricula"></input>
                    </div>

                    <div class="input">
                        <label>Senha:</label>
                        <input type="password" placeholder="Crie sua senha"></input>
                    </div>

                    <button class="btn">Cadastrar</button>

                </form>

            <div/>

        <div/>

        <div class="content second-content">

            <div class="first-column">

                <h2 class="title">Olá, amigo!</h2>
                <p class="description">Ainda não é cadastrado?</p>
                <p class="description">Realize o cadastrado no sistema com suas informações</p>
                <button class="btn">Cadastrar</button>

            <div/>

            <div class="second-column">

                <h2 class="title">Login</h2>
                <p class="description">Bem vindo de volta ao Camaar</p>

                <form class="form">

                    <div class="input">
                        <label>Email:</label>
                        <input type="email" placeholder="aluno@aluno.unb.br"></input>
                    </div>

                    <div class="input">
                        <label>Senha:</label>
                        <input type="password" placeholder="Password"></input>
                    </div>

                    <button class="btn">Login</button>

                </form>

            <div/>
        <div/>
    <div/>
<div/>
