<% content_for :home_index_js do %>
  <script src="home_index.js"></script>
<% end %>

<body>

    <div class="container">

        <div class="content first-content">

            <div class="first-column">

                <h2 class="title title-primary">Bem vindo ao Camaar</h2>
                <p class="description description-primary">Por favor realize o login com suas informações pessoais</p>
                <button id="signin" class="btn btn-primary">Login</button>

            </div>

            <div class="second-column">

                <h2 class="title title-second">Criar conta</h2>
                <p class="description description-second">Por favor preencha os campos abaixo</p>

                <form class="form">

                    <div class="input">
                        <label>Nome:</label>
                        <input type="text" placeholder="Insira o seu nome completo">
                    </div>

                    <div class="input">
                        <label>Email:</label>
                        <input type="email" placeholder="Informe seu e-mail">
                    </div>

                    <div class="input"> 
                        <label>Tipo de usuário:</label>
                        <select>
                            <option value="0">Selecione</option>
                            <option value="1">Docente</option>
                            <option value="2">Discente</option>
                        </select>
                    </div>

                    <div class="input"> 
                        <label>Matricula:</label>
                        <input type="text" placeholder="Informe sua matricula">
                    </div>

                    <div class="input">
                        <label>Senha:</label>
                        <input type="password" placeholder="Crie sua senha">
                    </div>

                    <button class="btn btn-second">Cadastrar</button>

                </form>

            </div>

        </div>

        <div class="content second-content">

            <div class="first-column">

                <h2 class="title title-primary">Olá, amigo!</h2>
                <p class="description description-primary">Ainda não é cadastrado?</p>
                <p class="description description-primary">Realize o cadastrado no sistema com suas informações</p>
                <button id="signup" class="btn btn-primary">Cadastrar</button>

            </div>

            <div class="second-column">

                <h2 class="title title-second">Login</h2>
                <p class="description description-second">Bem vindo de volta ao Camaar</p>

                <form class="form">

                    <div class="input">
                        <label>Email:</label>
                        <input type="email" placeholder="aluno@aluno.unb.br">
                    </div>

                    <div class="input">
                        <label>Senha:</label>
                        <input type="password" placeholder="Password">
                    </div>

                    <button id="forgetspassword" type="button" class="forgetspassword">Esqueceu a senha?</button>

                    <button class="btn btn-second">Login</button>

                </form>

            </div>

            <div class="third-column">

                    <h2 class="title title-second">Login</h2>
                    <p class="description description-second">Problemas ao iniciar sessão?</p>
                    <p class="description description-second">Insira o seu e-mail e nova senha</p>

                    <form class="form">

                    <div class="input">
                        <label>Email:</label>
                        <input type="email" placeholder="aluno@aluno.unb.br">
                    </div>

                    <div class="input">
                        <label>Senha:</label>
                        <input type="password" placeholder="Password">
                    </div>

                    <div class="input">
                        <label>Confirme a senha:</label>
                        <input type="password" placeholder="Password">
                    </div>

                    <button class="btn btn-second">Alterar senha</button>

                    </form>

                </div>
                            
        </div>

    </div>

</body>
