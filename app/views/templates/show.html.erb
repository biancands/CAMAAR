<% content_for :navbar_title do %>
  Gerenciamento Templates
<% end %>
<head>
  <title>Templates</title>
  <%= stylesheet_link_tag 'templates', media: 'all' %> <!-- Importa o CSS específico -->
  <%= javascript_include_tag 'templates' %> <!-- Importa o JS específico -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <%= render 'shared/navbar' %>
    <div class="bg">
    <div id="cards-container" class="cards">
        
    </div>

<%# //////////////////////// MODAL //////////////////////// %>
<div id="modal" class="modal">
  <div class="modal-content">
    <span id="close-modal" class="close">&times;</span>

    <form id="form-template">
      <!-- Nome do Template -->
      <div>
        <label for="template-name">Nome do template:</label>
        <input type="text" id="template-name" placeholder="Placeholder" required>
      </div>

      <!-- Contêiner de Questões -->
      <div id="questions-container">
      </div>
      <!-- Botão para Adicionar Nova Questão -->
      <button type="button" id="add-question" class="add-question">+</button>
      <!-- Botão Final para Criar -->
      <button type="submit" id="create-template" class="create-template">Criar</button>
    </form>
  </div>
</div>


</body>